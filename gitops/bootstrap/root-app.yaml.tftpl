apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: ${root_application_name}
  namespace: ${namespace}
  # Cascade deletion: when Terraform deletes this Application, ArgoCD deletes
  # the child Applications it manages (and they, in turn, their resources)
  # instead of orphaning them in the cluster.
  finalizers:
    - resources-finalizer.argocd.argoproj.io
spec:
  project: default
  source:
    repoURL: ${repo_url}
    targetRevision: ${target_revision}
    path: ${apps_path}
    directory:
      recurse: true
      # Each app's own manifests/ subfolder is applied by that app's own
      # child Application (via its own source.path), not by the root — those
      # manifests have no namespace set, since they rely on being scoped by
      # the child Application's destination.namespace.
      exclude: "*/manifests/**"
  destination:
    server: https://kubernetes.default.svc
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
      - CreateNamespace=true
