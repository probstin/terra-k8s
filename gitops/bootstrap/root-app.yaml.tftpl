apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: ${root_application_name}
  namespace: ${namespace}
spec:
  project: default
  source:
    repoURL: ${repo_url}
    targetRevision: ${target_revision}
    path: ${apps_path}
    directory:
      recurse: true
  destination:
    server: https://kubernetes.default.svc
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
      - CreateNamespace=true
